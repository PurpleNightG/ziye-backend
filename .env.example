# 数据库配置
DB_HOST=mysql6.sqlpub.com
DB_PORT=3311
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=png_management

# JWT密钥（请修改为您自己的安全密钥）
JWT_SECRET=your_secret_key_here

# 火山引擎 RTC（屏幕共享 / 会议）
VOLC_APP_ID=your_volc_app_id
VOLC_APP_KEY=your_volc_app_key

# 服务器端口
PORT=3000

# 紫夜自建流媒体上游地址（API 代理 WHIP/WHEP 用）
ZIYE_UPSTREAM_URL=http://160.202.254.36:10116

# QQ / Foxmail SMTP（管理员异地登录验证码；与光幕策校园墙一致用 587）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your_foxmail@foxmail.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM_NAME=紫夜战术公会

# 操作密钥（安全中心踢人/删号等写操作必填；勿提交真实值；部署时请换成强随机串）
SUPER_ADMIN_SECRET=change_me_to_a_strong_secret

# 智谱 AI（管理端智能助手；优先 glm-4.5-flash）
# 申请：https://open.bigmodel.cn/
# 过载/限流时按 FALLBACK 链降级（逗号分隔）
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_FALLBACK_MODEL=glm-4.7-flash,glm-4-flash

# 生产环境前面有 Nginx/Caddy/平台反代时设为 1（信任 X-Forwarded-For 取真实 IP）
TRUST_PROXY=1
